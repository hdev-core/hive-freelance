# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://hive:hive@localhost:5433/hive_freelance

# Hive chain
# There's no usable public Hive testnet (it requires running your own hived
# node) — this points at mainnet, including for PROVISIONER_LIVE=true.
# See Auth_Guide.md for seeded dev signer account setup.
HIVE_API_NODE=https://api.hive.blog
APP_ID=hive-freelance-v1

# Auth — REQUIRED. This file is a template only and is never loaded by the
# app itself; you must set a real value in your own untracked .env.
JWT_SECRET=change-me-in-development-only

# Platform agent account (active key via KMS — never commit real keys)
AGENT_ACCOUNT=hive-freelance-agent
KMS_MODE=local
# Only for local/dev KMS stub — leave empty in production
LOCAL_AGENT_ACTIVE_KEY=
# When true, agent escrow_approve uses live KMS/broadcast path
AGENT_LIVE=false

# Google OAuth (leave empty to use POST /auth/dev-google locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Provisioning / claim / custodial (chain broadcast opt-in).
# PROVISIONER_LIVE=true broadcasts against real mainnet and costs real HIVE
# (account creation fee) via PROVISIONER_CREATOR_ACCOUNT — leave false for
# routine local testing; dry-run still generates real keys + a real DB user.
PROVISIONER_LIVE=false
PROVISIONER_CREATOR_ACCOUNT=
LOCAL_CREATOR_ACTIVE_KEY=
HIVE_ACCOUNT_CREATION_FEE=3.000 HIVE
HIVE_RC_DELEGATION_VESTS=10.000000 VESTS
CLAIM_LIVE=false
CUSTODIAL_LIVE=false

# Escrow confirm behaviour
# Terminal released/refunded from client confirm (demo only; default listener@LIB)
ESCROW_TRUST_CLIENT_CONFIRM=false
# Promote to escrowed after both approve tx refs without chain LIB (local UI demo)
ESCROW_DRY_DEMO=false
# Warn Keychain users when RC % is below this threshold
RC_WARNING_PCT=5

# Dev-only auth routes (dev-keychain-login, dev-google) — off by default even
# outside production. Set both this AND NODE_ENV!=production to enable.
ENABLE_DEV_AUTH_ROUTES=false

# Seeded dev signer account used by POST /auth/dev-keychain-login to produce
# genuine Keychain-style signatures in dev (see Auth_Guide.md — free signup
# via signup.hive.io / hiveonboard.com / peakd.com/join). A real but
# low-value throwaway account; never a real user's key.
DEV_SEED_HIVE_USERNAME=
DEV_SEED_POSTING_KEY=

# API / Web
API_PORT=4000
WEB_PORT=5173
# Leave empty in local dev so the browser uses Vite's proxy (same-origin cookies).
# Set to http://localhost:4000 only if you intentionally bypass the proxy.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:5173

# Listener
LISTENER_POLL_MS=3000
LISTENER_START_FROM_HEAD=true
