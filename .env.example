# PostgreSQL (matches docker-compose.yml defaults — host port 5433 to avoid clashing
# with other local Postgres containers; container-internal port is still 5432)
DATABASE_URL=postgresql://hive:hive@localhost:5433/hive_freelance

# Hive chain
HIVE_API_NODE=https://api.hive.blog
APP_ID=hive-freelance-v1

# Auth (JWT used later; required for env completeness)
JWT_SECRET=change-me-in-development-only

# Platform agent account (active key via KMS — never commit real keys)
AGENT_ACCOUNT=hive-freelance-agent
KMS_MODE=local
# Only for local/dev KMS stub — leave empty in production
LOCAL_AGENT_ACTIVE_KEY=
# When true, agent escrow_approve uses live KMS/broadcast path
AGENT_LIVE=false

# Google OAuth (leave empty to use POST /auth/dev-google locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Provisioning / claim / custodial (chain broadcast opt-in)
PROVISIONER_LIVE=false
PROVISIONER_CREATOR_ACCOUNT=
LOCAL_CREATOR_ACTIVE_KEY=
CLAIM_LIVE=false
CUSTODIAL_LIVE=false

# Escrow confirm behaviour
# Terminal released/refunded from client confirm (demo only; default listener@LIB)
ESCROW_TRUST_CLIENT_CONFIRM=false
# Promote to escrowed after both approve tx refs without chain LIB (local UI demo)
ESCROW_DRY_DEMO=false
# Warn Keychain users when RC % is below this threshold
RC_WARNING_PCT=5

AUTH_RELAXED=false

# API / Web
API_PORT=4000
WEB_PORT=5173
# Leave empty in local dev so the browser uses Vite's proxy (same-origin cookies).
# Set to http://localhost:4000 only if you intentionally bypass the proxy.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:5173

# Listener
LISTENER_POLL_MS=3000
LISTENER_START_FROM_HEAD=true
